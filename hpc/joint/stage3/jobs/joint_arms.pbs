#!/bin/bash
#PBS -N joint_arms
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
#
# One array element per (arm, seed). The index is decoded as
#
#     arm  = ARMS[ IDX % n_arms ]
#     seed = IDX / n_arms
#
# so a contiguous range covers every combination and a failed element costs one
# arm-seed, not the campaign.
#
# Dry run first (no allocation needed, no training):
#
#   DRYRUN=1 SIM_SHARDS='/path/S/*.npz' REAL_SHARDS='/path/R/*.npz' \
#   OUT_DIR=/tmp/arms PBS_ARRAY_INDEX=0 bash jobs/joint_arms.pbs
#
# Then ONE element for real, then the array:
#
#   qsub -J 0-44 -v SIM_SHARDS=...,REAL_SHARDS=...,OUT_DIR=... jobs/joint_arms.pbs
#
# Expected output of a correct element: "arm : <name> (seed k)" followed by
# L, L0, delta_hat, r_eff, p_eff and the written paths. A "p_eff (spectrum):
# n/a" line means the report split is too small for the generalised
# eigenproblem, NOT that the arm learned nothing -- widen the split.
#
# ARM ORDER IS PART OF THE INDEX MAP. Changing it renumbers every job, so a
# resubmission of "the failed elements" would run different arms. Append, never
# reorder.

set -euo pipefail

REPO=""
for cand in "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)" \
            "${PBS_O_WORKDIR:-}"; do
  if [ -n "$cand" ] && [ -f "$cand/run_joint_arms.py" ]; then
    REPO="$cand"; break
  fi
done
if [ -z "$REPO" ]; then
  echo "FATAL: could not locate stage3. Candidates tried:" >&2
  echo "  dirname(BASH_SOURCE)/..: $(dirname "${BASH_SOURCE[0]}")/.." >&2
  echo "  PBS_O_WORKDIR         : ${PBS_O_WORKDIR:-<unset>}" >&2
  exit 2
fi
cd "$REPO"

: "${SIM_SHARDS:=}"
: "${REAL_SHARDS:=}"
: "${OUT_DIR:=}"
: "${EPOCHS:=10}"
: "${STEPS_PER_EPOCH:=25}"
: "${B_SIM:=128}"
: "${LAMBDA_DSN:=0.1}"
: "${LAMBDA_REP:=0.05}"
: "${N_DRAWS:=128}"
: "${ENCODER_STEPS:=200}"
: "${WARM_START_CKPT:=}"
: "${ENV_NAME:=sbi_env}"
: "${DRYRUN:=0}"

if [ -z "$SIM_SHARDS" ] || [ -z "$OUT_DIR" ]; then
  echo "FATAL: SIM_SHARDS and OUT_DIR must be set (-v SIM_SHARDS=...,OUT_DIR=...)" >&2
  exit 2
fi

ARMS=(A1 A0 A0s A2 A2s A3 A5 A_ref shuffled)
N_ARMS=${#ARMS[@]}
IDX="${PBS_ARRAY_INDEX:-0}"
ARM="${ARMS[$((IDX % N_ARMS))]}"
SEED=$((IDX / N_ARMS))

echo "index            : $IDX  ->  arm $ARM, seed $SEED"
echo "repo             : $REPO"

if [ "$DRYRUN" != "1" ]; then
  # `set -u` MUST be off across the hook AND the activate. The hook
  # deactivates the current env, which sources base's deactivate.d/
  # scripts; those are third-party and not -u clean (confirmed on
  # davinci: geotiff-deactivate.sh line 5, _CONDA_SET_GEOTIFF_CSV).
  # Under -u that aborts, conda returns non-zero, and -e kills the job
  # before a single line of science runs. Restore -u immediately after.
  set +u
  eval "$(conda shell.bash hook)"
  conda activate "$ENV_NAME"
  set -u
fi
PY="$(command -v python3)"
echo "interpreter      : $PY"
echo "conda env        : ${CONDA_DEFAULT_ENV:-none}"

EXTRA=()
if [ -n "$REAL_SHARDS" ]; then EXTRA+=(--real-shards "$REAL_SHARDS"); fi
if [ "$ARM" = "A3" ] && [ -n "$WARM_START_CKPT" ]; then
  EXTRA+=(--warm-start-ckpt "$WARM_START_CKPT")
fi
if [ "$DRYRUN" = "1" ]; then EXTRA+=(--dry-run); fi

mkdir -p "$OUT_DIR"

"$PY" run_joint_arms.py \
  --arm "$ARM" \
  --seed "$SEED" \
  --sim-shards "$SIM_SHARDS" \
  --out-dir "$OUT_DIR" \
  --epochs "$EPOCHS" \
  --steps-per-epoch "$STEPS_PER_EPOCH" \
  --b-sim "$B_SIM" \
  --lambda-dsn "$LAMBDA_DSN" \
  --lambda-rep "$LAMBDA_REP" \
  --n-posterior-draws "$N_DRAWS" \
  --encoder-steps "$ENCODER_STEPS" \
  "${EXTRA[@]}"

echo "DONE $ARM seed $SEED"
