#!/bin/bash
#PBS -N device_check
#PBS -j oe
# hpc/joint/stage3/jobs/device_check.pbs -- the GPU check of block 39 (D-169).
#
# One job, one of three things, chosen by MODE (qsub -v):
#   info   what the node offers: nvidia-smi, and torch's view of it in
#          ENV_NAME when that environment exists (the default)
#   suite  hpc/joint/stage3/smoke_test_device.py in ENV_NAME; on a GPU its
#          last line must read `... 0 fail, 0 skip`
#   argv   the command of ARGV_FILE (one argument per line, as the
#          pipeline's argv files; made by device_probe_argv.py), run in
#          WORKDIR
#
# The resources and the log go on the qsub line, for instance:
#   qsub -q gpu -l select=1:ncpus=8:ngpus=1:mem=120gb -l walltime=01:00:00 \
#        -o $HOME/gpu_check/suite.log \
#        -v MODE=suite,ENV_NAME=sbi_gpu,REPO=$HOME/SBI hpc/joint/stage3/jobs/device_check.pbs
#
# Variables: MODE (info), ENV_NAME (sbi_gpu), REPO (the checkout; default
# PBS_O_WORKDIR's git root), ARGV_FILE and WORKDIR (MODE=argv).
#
# The GPU [2026-11-26]: davinci's PBS gives a job with ngpus=1 no
# CUDA_VISIBLE_DEVICES (job 2104617 saw all four GPUs of its node, GPU 0
# with 37.9 GB in use by another job), and torch takes GPU 0 by default. So,
# when the variable is unset, the script sets it to the GPU with the fewest
# compute processes and, among those, the least memory in use, and prints
# `gpu choice       : index <i> (<uuid>): <p> other process(es), <m> MiB in
# use, <u> % busy at the start -> idle|shared`. A value set before the
# script is kept. The GPU processes and PBS's exec_vnode are printed first.
#
# It reads the repository and writes only where its command writes. It does
# not use the pipeline's work roots, chain or avoid list. Exit 2 = a missing
# variable or file, 96 = the environment cannot start, else the command's.
# The last line is `DEVICE_CHECK EXIT: <n>`.
#
# Pure ASCII, LF only.

set -uo pipefail

: "${MODE:=info}"
: "${ENV_NAME:=sbi_gpu}"
: "${REPO:=}"
: "${ARGV_FILE:=}"
: "${WORKDIR:=}"

finish() { echo "DEVICE_CHECK EXIT: $1"; exit "$1"; }

if [ -z "$REPO" ]; then
  REPO="$(cd "${PBS_O_WORKDIR:-$PWD}" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || REPO=""
fi
if [ -z "$REPO" ] || [ ! -f "$REPO/hpc/joint/stage3/run_joint_arms.py" ]; then
  echo "FATAL: REPO is not the checkout (no hpc/joint/stage3/run_joint_arms.py under '$REPO'); pass -v REPO=..." >&2
  finish 2
fi

echo "host             : $(hostname)"
echo "job              : ${PBS_JOBID:-none}  queue ${PBS_QUEUE:-none}"
echo "mode             : $MODE"
echo "repo             : $REPO ($(git -C "$REPO" log -1 --format='%h' 2>/dev/null))"
echo "NCPUS            : ${NCPUS:-unset}  CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=index,name,memory.total,memory.used,driver_version --format=csv
  nvidia-smi | grep -i "cuda version" || true
else
  echo "nvidia-smi       : not found on this node"
fi
if command -v qstat >/dev/null 2>&1 && [ -n "${PBS_JOBID:-}" ]; then
  qstat -f "$PBS_JOBID" 2>/dev/null | sed ':a;N;$!ba;s/\n\t//g' | grep -E "exec_vnode" || true
fi

# the GPU this job uses (see the header)
if command -v nvidia-smi >/dev/null 2>&1; then
  echo "gpu processes    : (gpu_uuid, pid, used_memory)"
  nvidia-smi --query-compute-apps=gpu_uuid,pid,used_memory --format=csv,noheader 2>/dev/null | sed 's/^/  /' || true
  if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    echo "gpu choice       : CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES was set before this script; kept"
  else
    GPUS="$(nvidia-smi --query-gpu=index,uuid,memory.used,utilization.gpu --format=csv,noheader,nounits 2>/dev/null)" || GPUS=""
    APPS="$(nvidia-smi --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null | tr '\n' ' ')" || APPS=""
    PICK="$(printf '%s\n' "$GPUS" | awk -F', *' -v apps="$APPS" '
      BEGIN { n = split(apps, a, " "); for (i = 1; i <= n; i++) busy[a[i]]++ }
      NF >= 4 { nb = busy[$2] + 0; m = $3 + 0
                if (best == "" || nb < bnb || (nb == bnb && m < bm)) { best = $1; bnb = nb; bm = m; bu = $4 + 0; bid = $2 } }
      END { if (best != "") print best, bnb, bm, bu, bid }')"
    if [ -n "$PICK" ]; then
      # shellcheck disable=SC2086
      set -- $PICK
      export CUDA_VISIBLE_DEVICES="$1"
      if [ "$2" = "0" ] && [ "$4" = "0" ]; then GPU_STATE="idle"; else GPU_STATE="shared"; fi
      echo "gpu choice       : index $1 ($5): $2 other process(es), $3 MiB in use, $4 % busy at the start -> $GPU_STATE; CUDA_VISIBLE_DEVICES=$1"
    else
      echo "gpu choice       : none (nvidia-smi lists no GPU)"
    fi
  fi
fi

ENV_OK=1
# shellcheck source=/dev/null
. "$REPO/hpc/pipeline/jobs/activate_env.sh"
pipeline_activate "$ENV_NAME" || ENV_OK=0
if [ "$ENV_OK" = "1" ]; then
  echo "conda env        : ${CONDA_DEFAULT_ENV:-none}  ($(command -v python3))"
  python3 -c "import torch; print('torch            : %s, CUDA build %s, GPU visible %s, devices %d' % (torch.__version__, torch.version.cuda, torch.cuda.is_available(), torch.cuda.device_count())); print('gpu              : %s' % (torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'none'))" \
    || echo "torch            : does not import in $ENV_NAME"
fi

case "$MODE" in
  info)
    if [ "$ENV_OK" = "1" ]; then echo "DEVICE_CHECK INFO OK"; else echo "DEVICE_CHECK INFO OK (environment $ENV_NAME not available: node facts only)"; fi
    finish 0 ;;
  suite)
    [ "$ENV_OK" = "1" ] || finish 96
    cd "$REPO/hpc/joint/stage3" || finish 2
    python3 smoke_test_device.py
    finish $? ;;
  argv)
    [ "$ENV_OK" = "1" ] || finish 96
    if [ -z "$ARGV_FILE" ] || [ ! -f "$ARGV_FILE" ]; then echo "FATAL: ARGV_FILE '$ARGV_FILE' not found" >&2; finish 2; fi
    if [ -z "$WORKDIR" ] || [ ! -d "$WORKDIR" ]; then echo "FATAL: WORKDIR '$WORKDIR' not found" >&2; finish 2; fi
    cd "$WORKDIR" || finish 2
    ARGV=()
    while IFS= read -r line || [ -n "$line" ]; do ARGV+=("$line"); done < "$ARGV_FILE"
    echo "command          : ${#ARGV[@]} argument(s) from $ARGV_FILE"
    if command -v nvidia-smi >/dev/null 2>&1; then
      nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used --format=csv -l 5 > "${ARGV_FILE%.argv}.gpu_util.csv" 2>/dev/null &
      SMI_PID=$!
    else
      SMI_PID=""
    fi
    "${ARGV[@]}"
    RC=$?
    [ -n "$SMI_PID" ] && kill "$SMI_PID" 2>/dev/null
    finish "$RC" ;;
  *)
    echo "FATAL: MODE must be info, suite or argv, got '$MODE'" >&2
    finish 2 ;;
esac
