#!/bin/bash
#PBS -N npe_smoke
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
###PBS -q FILL_IN_QUEUE_NAME
###PBS -l select=1:ncpus=8:mem=32gb:ngpus=1   # uncomment for a GPU node
#
# Smoke tests for the SBI / NPE stage.
#
# BEFORE FIRST SUBMISSION
#   1. Set the queue on the #PBS -q line above and uncomment it.
#   2. Set CONDA_ENV below to the environment holding the requirements.
#   3. Run the cluster-side sanity check in the README once, by hand.
#
# Submit with:   qsub jobs/smoke_test.pbs
#
# Note the tests run on CPU by default. NPEConfig(device="cuda") switches
# the estimator to GPU, but these suites are small enough that CPU is
# usually faster once queueing time is counted.

set -euo pipefail

CONDA_ENV="${CONDA_ENV:-sbi_env}"

cd "${PBS_O_WORKDIR:-$(pwd)}"
echo "host      : $(hostname)"
echo "workdir   : $(pwd)"
echo "started   : $(date -Is)"

# ---- environment -----------------------------------------------------------
if command -v conda >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    source "$(conda info --base)/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
fi

python3 -c "import sys; print('python    :', sys.version.split()[0])"
python3 -c "import torch, sbi, zuko; print('torch     :', torch.__version__); print('sbi/zuko  :', sbi.__version__, zuko.__version__)"

# ---- guard: every .py in the import chain must be pure ASCII ---------------
# A non-ASCII byte that survived a Windows/cp1252 transfer raises SyntaxError
# at import time, which on a cluster costs a whole submission cycle to find.
python3 - npe_contract.py npe_model.py gmm_benchmark.py \
           smoke_test_npe.py smoke_test_gmm.py << 'PYEOF'
import sys
bad_files = []
for path in sys.argv[1:]:
    data = open(path, 'rb').read()
    bad = [(i + 1, hex(b)) for i, b in enumerate(data) if b > 127]
    crlf = data.count(b'\r\n')
    status = 'ASCII OK' if not bad else 'NON-ASCII %s' % bad[:5]
    print('  %-22s %-28s CRLF=%d' % (path, status, crlf))
    if bad or crlf:
        bad_files.append(path)
if bad_files:
    print('ABORT: encoding problems in %s' % bad_files)
    sys.exit(1)
PYEOF

python3 -m py_compile npe_contract.py npe_model.py gmm_benchmark.py \
                     smoke_test_npe.py smoke_test_gmm.py
echo "compile OK"

# ---- the suites ------------------------------------------------------------
echo
echo "=== NPE pipeline suite ==="
python3 smoke_test_npe.py

echo
echo "=== Gaussian-mixture recovery suite ==="
python3 smoke_test_gmm.py

echo
echo "finished  : $(date -Is)"
