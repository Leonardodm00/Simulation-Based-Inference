#!/bin/bash
#PBS -N npe_replot
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
###PBS -q FILL_IN_QUEUE_NAME
#
# Regenerate diagnostics and figures from a FINISHED run.
#
# RUN_DIR is required. Everything else is optional:
#
#     qsub -v RUN_DIR=synthetic_trial_20260811_152440 jobs/replot.pbs
#     qsub -v RUN_DIR=<dir>,RECOVER=1 jobs/replot.pbs
#     qsub -v RUN_DIR=<dir>,N_FORMS=8,SEED=1 jobs/replot.pbs
#     qsub -v RUN_DIR=<dir>,OUT_DIR=/scratch/me/figs jobs/replot.pbs
#
# RECOVER=1 first rebuilds diagnostics_data.npz for a run that predates it,
# by reloading the shards, reproducing the calibration split from the stored
# seed, and re-sampling from the saved ensemble. That needs the run to have
# been made with --save-model. It is also the only slow step here: without
# it this job is a few minutes at most, which is why the walltime is short.
#
# RECOVER=auto (the default) runs the recovery only if the npz is missing,
# which is usually what you want -- it makes the job idempotent and safe to
# resubmit.

set -uo pipefail

CONDA_ENV="${CONDA_ENV:-sbi_env}"
RUN_DIR="${RUN_DIR:-}"
OUT_DIR="${OUT_DIR:-}"
RECOVER="${RECOVER:-auto}"
N_FORMS="${N_FORMS:-4}"
SEED="${SEED:-0}"
N_NULL="${N_NULL:-500}"
N_DRAWS="${N_DRAWS:-}"

cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1
mkdir -p logs

echo "host      : $(hostname)"
echo "jobid     : ${PBS_JOBID:-interactive}"
echo "workdir   : $(pwd)"
echo "started   : $(date -Is)"

# ---- validate before spending any queue time -------------------------------
if [ -z "$RUN_DIR" ]; then
    echo
    echo "FATAL: RUN_DIR not set. This job cannot guess which run to plot."
    echo "  qsub -v RUN_DIR=synthetic_trial_YYYYMMDD_HHMMSS jobs/replot.pbs"
    echo
    echo "Available runs here:"
    ls -dt synthetic_trial_* 2>/dev/null | head -10 || echo "  (none found)"
    exit 2
fi
if [ ! -d "$RUN_DIR" ]; then
    echo "FATAL: RUN_DIR '$RUN_DIR' is not a directory (relative to $(pwd))."
    exit 2
fi
echo "run dir   : $RUN_DIR"

# ---- environment -----------------------------------------------------------
# set +u is REQUIRED: conda.sh reads variables that are unset in a
# non-interactive shell, and under `set -u` that kills the job silently.
if command -v conda >/dev/null 2>&1; then
    set +u
    # shellcheck disable=SC1091
    source "$(conda info --base)/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
    set -u
fi
python -c "import sys; print('python    :', sys.version.split()[0])"
python -c "import matplotlib; print('matplotlib:', matplotlib.__version__)" || {
    echo "FATAL: matplotlib missing. pip install matplotlib"
    exit 1
}

NCPUS="${NCPUS:-${PBS_NCPUS:-4}}"
export OMP_NUM_THREADS="$NCPUS"
export MKL_NUM_THREADS="$NCPUS"
# matplotlib needs a writable cache; on a compute node HOME may be read-only
# or slow, and a failure here surfaces as an unhelpful font-cache error.
export MPLCONFIGDIR="${MPLCONFIGDIR:-$PWD/.mplcache}"
mkdir -p "$MPLCONFIGDIR"

sed -i 's/\r$//' ./*.py 2>/dev/null || true

# ---- recovery, if needed ---------------------------------------------------
NPZ="$RUN_DIR/diagnostics_data.npz"
DO_RECOVER=0
case "$RECOVER" in
    1|yes|true) DO_RECOVER=1 ;;
    auto)       [ -f "$NPZ" ] || DO_RECOVER=1 ;;
    0|no|false) DO_RECOVER=0 ;;
    *) echo "WARNING: unrecognised RECOVER='$RECOVER', treating as auto"
       [ -f "$NPZ" ] || DO_RECOVER=1 ;;
esac

if [ "$DO_RECOVER" -eq 1 ]; then
    echo
    echo "=== rebuilding $NPZ ==="
    if [ ! -d "$RUN_DIR/ensemble" ]; then
        echo "FATAL: $RUN_DIR/ensemble does not exist, so the run was made"
        echo "without --save-model and the trained networks are gone. The"
        echo "posterior samples cannot be regenerated. Re-run the trial:"
        echo "    qsub -v SAVE_MODEL=1 jobs/synthetic_trial.pbs"
        exit 1
    fi
    REC_ARGS=("$RUN_DIR")
    [ -n "$N_DRAWS" ] && REC_ARGS+=(--n-draws "$N_DRAWS")
    echo "command   : python recover_npz.py ${REC_ARGS[*]}"
    python recover_npz.py "${REC_ARGS[@]}"
    REC_STATUS=$?
    if [ "$REC_STATUS" -ne 0 ]; then
        echo "recovery failed (exit $REC_STATUS); nothing to plot."
        exit "$REC_STATUS"
    fi
elif [ -f "$NPZ" ]; then
    echo "  $NPZ present; skipping recovery"
else
    echo "  WARNING: $NPZ is missing and RECOVER=$RECOVER disables rebuilding."
    echo "  replot.py will fail. Resubmit with RECOVER=1 (or RECOVER=auto)."
fi

# ---- replot ----------------------------------------------------------------
echo
echo "=== replot ==="
ARGS=("$RUN_DIR" --n-forms "$N_FORMS" --seed "$SEED" --n-null "$N_NULL")
[ -n "$OUT_DIR" ] && ARGS+=(--out-dir "$OUT_DIR")
echo "command   : python replot.py ${ARGS[*]}"
python replot.py "${ARGS[@]}"
STATUS=$?

echo
echo "exit code : $STATUS"
echo "finished  : $(date -Is)"

if [ "$STATUS" -eq 0 ]; then
    FIGS="${OUT_DIR:-$RUN_DIR/figures}"
    echo
    echo "Figures in $FIGS:"
    ls -la "$FIGS" 2>/dev/null | tail -n +2
    # $USER is not guaranteed to be exported in a non-interactive shell, and
    # under `set -u` referencing it unset is fatal -- which would fail the job
    # AFTER all the real work succeeded, the worst possible time. Fall back
    # through several sources and never let this convenience line break the
    # exit status.
    WHO="${USER:-${LOGNAME:-$(id -un 2>/dev/null || echo user)}}"
    FIGS_ABS="$(cd "$FIGS" 2>/dev/null && pwd || echo "$FIGS")"
    echo
    echo "Copy them locally with:"
    echo "  scp -r ${WHO}@$(hostname):${FIGS_ABS} ."
fi

exit "$STATUS"
