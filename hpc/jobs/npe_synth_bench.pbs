#!/bin/bash
#PBS -N npe_synth_bench
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o logs/
###PBS -q FILL_IN_QUEUE_NAME
#
# Stage 1 of the tuning protocol: prove the tuner is correct against a
# problem with an EXACT analytic posterior, BEFORE the real campaign spends
# any budget.
#
# This job needs no bank, no export, no encoder and no real data. It builds
# its own ground truth from gmm_benchmark.py. That is the point: if it
# fails, the fault is in the tuner, not in the data.
#
# BEFORE FIRST SUBMISSION
#   1. Set the queue on the #PBS -q line above and uncomment it.
#   2. Set CONDA_ENV below if the inference environment is not sbi_env.
#      HPC_PATHS.md section 7 flags an unresolved sbi_export vs sbi_env
#      conflict -- settle it with `python check_env.py` first.
#   3. Run the plumbing check interactively FIRST (minutes, not hours):
#          bash jobs/npe_synth_bench.pbs   # with QUICK=1 set below
#      or directly:
#          python3 run_synthetic_benchmark.py --quick --out-dir /tmp/q
#
# Submit:
#     qsub -v OUT_DIR=synth_bench_01 jobs/npe_synth_bench.pbs
#     qsub -v OUT_DIR=synth_q,QUICK=1 jobs/npe_synth_bench.pbs   # plumbing
#     qsub -v OUT_DIR=sb,SHAPES="shape_A_repo_reference" jobs/npe_synth_bench.pbs
#
# WHAT CORRECT OUTPUT LOOKS LIKE. Per shape: a floor line with a small
# standard error; a shape report; a handful of trained trials whose gain
# RISES as the search proceeds; then five or six assertion lines. The two
# that matter most, and that must both appear, are
#
#     [PASS] G1 REJECTS the prior-equal posterior
#     [PASS] G2 PASSES the prior-equal posterior (documented blind spot)
#
# because together they prove the battery can fail something AND that the
# two gates are not redundant. A run in which every assertion passes but
# those two lines are absent has not tested what this stage exists to test.
#
# The last line is either ALL SHAPES PASSED or a list of failures, and the
# exit code follows it, so this is safe as a gate before the real campaign.

set -uo pipefail

CONDA_ENV="${CONDA_ENV:-sbi_env}"
OUT_DIR="${OUT_DIR:-synth_bench_$(date +%Y%m%d_%H%M%S)}"
QUICK="${QUICK:-0}"
SHAPES="${SHAPES:-}"
STRICT="${STRICT:-0}"
EXTRA_ARGS="${EXTRA_ARGS:-}"

cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1
mkdir -p logs

echo "host      : $(hostname)"
echo "jobid     : ${PBS_JOBID:-interactive}"
echo "workdir   : $(pwd)"
echo "started   : $(date -Is)"
echo "out dir   : ${OUT_DIR}"
echo "quick     : ${QUICK}"

# ---- environment -----------------------------------------------------------
# set +u is REQUIRED around conda: conda.sh references variables that are
# unset in a non-interactive shell, which under `set -u` kills the shell
# silently -- the failure then looks like a job that printed a header and
# nothing else.
if command -v conda >/dev/null 2>&1; then
    set +u
    # shellcheck disable=SC1091
    source "$(conda info --base)/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
    set -u
else
    echo "WARNING: conda not on PATH; using whatever python is available"
fi

python -c "import sys; print('python    :', sys.version.split()[0])"
python -c "import torch, sbi, zuko; print('torch     :', torch.__version__); print('sbi/zuko  :', sbi.__version__, zuko.__version__)" || {
    echo "FATAL: the SBI stack does not import. Run 'python check_env.py'."
    exit 1
}
python -c "import skopt; print('skopt     :', skopt.__version__)" || {
    echo "FATAL: scikit-optimize is required by this stage (the GP search is"
    echo "       one of the things being validated). Install it pinned:"
    echo "       pip install scikit-optimize==0.10.2"
    exit 1
}
python -c "import sklearn; print('sklearn   :', sklearn.__version__)" || {
    echo "FATAL: scikit-learn is required (C2ST uses MLPClassifier)."
    exit 1
}
echo "conda env : ${CONDA_DEFAULT_ENV:-none}"

# Keep BLAS from oversubscribing the allocation.
NCPUS="${NCPUS:-${PBS_NCPUS:-8}}"
export OMP_NUM_THREADS="$NCPUS"
export MKL_NUM_THREADS="$NCPUS"
echo "threads   : $NCPUS"

# ---- assemble arguments ----------------------------------------------------
ARGS="--out-dir ${OUT_DIR}"
if [ "${QUICK}" = "1" ]; then
    ARGS="${ARGS} --quick"
fi
if [ "${STRICT}" = "1" ]; then
    ARGS="${ARGS} --strict-recovery --strict-calibration"
fi
if [ -n "${SHAPES}" ]; then
    ARGS="${ARGS} --shapes ${SHAPES}"
fi

echo "----------------------------------------------------------------"
# shellcheck disable=SC2086
python run_synthetic_benchmark.py ${ARGS} ${EXTRA_ARGS}
STATUS=$?
echo "----------------------------------------------------------------"
echo "finished  : $(date -Is)  exit=${STATUS}"

if [ ${STATUS} -eq 0 ]; then
    echo "Stage 1 PASSED. The tuner is validated against known ground truth."
    echo "Next: python npe_tune.py freeze-split --sim <shards> --out-dir <run>"
else
    echo "Stage 1 FAILED. Per the protocol's decision rule the real campaign"
    echo "does not start until every assertion passes. Read the assertion"
    echo "lines above and ${OUT_DIR}/benchmark_report.json."
fi
exit ${STATUS}
