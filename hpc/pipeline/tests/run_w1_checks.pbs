#!/bin/bash
#PBS -N w1check
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=01:30:00
#PBS -j oe
# =============================================================================
# run_w1_checks.pbs -- the suites of the fix wave W1 (D-134), on a COMPUTE node
#
# Runs, from a checkout of sci/pipeline that is NOT the one a chain is running
# from, the three suites of the wave and three of the suites around them:
#
#   test_smoke_theta_box.py   block 11's amendment of 2026-11-14 (theta inside
#                             the open box, the record tool, the folder race)
#   test_smoke_identity.py    block 7 (j) (the search's identity re-checked)
#   test_smoke_finalist.py    block 7 (i) (the best fit follows its search)
#   test_smoke_pipeline.py    the sequencer
#   test_smoke_block7.py      the search and the best fit
#   test_smoke_synthetic.py   the synthetic data set's stages
#
# Every suite builds its own reduced project in a temporary folder and drives
# it with the tests' fake PBS (tests/fake_pbs): no real job is submitted, no
# bank, search or state of a real project is read or written, and nothing is
# left behind but the logs named below.
#
# Submit from ANY login node (the -o path is absolute, so the log is found):
#   qsub -q cpu -o $HOME/w1_checks.log -v W1_REPO=$HOME/SBI_w1 $HOME/SBI_w1/hpc/pipeline/tests/run_w1_checks.pbs
# Then, when the job has ended (about 15 minutes), from any login node:
#   grep '^W1CHECK' $HOME/w1_checks.log
#
# Pass lines (each must APPEAR): one `W1CHECK: <suite>: rc 0: <summary>` per
# suite, with these summaries --
#   test_smoke_theta_box.py   -- 6 pass, 0 fail, 0 error, 0 todo, 1 skip
#   test_smoke_identity.py    5 of 7 checks pass
#   test_smoke_finalist.py    -- 6 pass, 0 fail, 0 error, 0 todo, 2 skip
#   test_smoke_pipeline.py    -- 6 pass, 0 fail, 0 error, 0 todo, 1 skip
#   test_smoke_block7.py      7 of 8 checks pass
#   test_smoke_synthetic.py   18 of 19 checks pass
# (the skips are checks that do not apply: convergence, and determinism where
# nothing is random) -- and the last line `W1CHECK: ALL 6 SUITES PASSED`.
# A suite that fails gives `W1CHECK: <suite>: rc <n>: ...` and the last line
# `W1CHECK: FAILED: <suites>`; its whole output is in
# $HOME/w1_checks/<suite>.log (send that file).
#
# Variables (qsub -v): W1_REPO, the checkout to test (default $HOME/SBI_w1);
# W1_ENV, the conda environment (default sbi_env, the projects' envs.train);
# W1_OUT, the folder of the per-suite logs (default $HOME/w1_checks).
#
# Pure ASCII, LF only.
# =============================================================================
set -eo pipefail

REPO="${W1_REPO:-$HOME/SBI_w1}"
ENV_NAME="${W1_ENV:-sbi_env}"
OUT="${W1_OUT:-$HOME/w1_checks}"
SUITES="test_smoke_theta_box.py test_smoke_identity.py test_smoke_finalist.py test_smoke_pipeline.py test_smoke_block7.py test_smoke_synthetic.py"
REF_COMMIT="8d5b16285140f1a4181c0901bf535c7da041ae39"   # test_smoke_theta_box.py's reference tree

echo "W1CHECK: host $(hostname), job ${PBS_JOBID:-<none>}, $(date -u +%Y-%m-%dT%H:%M:%SZ)"

TESTS="$REPO/hpc/pipeline/tests"
if [ ! -f "$TESTS/test_smoke_finalist.py" ]; then
    echo "W1CHECK: REFUSE: $REPO is not a checkout with the wave's suites (no $TESTS/test_smoke_finalist.py); give -v W1_REPO=<checkout>"
    exit 2
fi

# The environment: the hook and the activation source third-party scripts that
# are not `set -u` clean, so -u is armed only after them (hpc-git-delivery).
if [ "${W1_SKIP_CONDA:-0}" != "1" ]; then
    eval "$(conda shell.bash hook)"
    conda activate "$ENV_NAME"
fi
set -u

# The suites drive the tests' fake PBS: nothing of this real job may reach
# them (the sequencer names itself by PBS_JOBID), and each suite decides for
# itself whether its jobs activate an environment.
REAL_JOB="${PBS_JOBID:-}"
for v in $(compgen -v | grep '^PBS_' || true); do unset "$v"; done
unset PIPELINE_SKIP_CONDA SKIP_CONDA FAKE_PBS_SPOOL || true
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1

cd "$REPO"
HEAD_NOW="$(git rev-parse --short HEAD)"
echo "W1CHECK: checkout $REPO at $HEAD_NOW ($(git log -1 --format=%s | cut -c1-70))"
if ! git cat-file -e "${REF_COMMIT}^{commit}" 2>/dev/null; then
    echo "W1CHECK: REFUSE: this checkout's history lacks $REF_COMMIT, which test_smoke_theta_box.py compares with (a shallow clone? use a worktree of ~/SBI)"
    exit 2
fi
python3 - <<'EOF'
import importlib, sys
out = ["python %s" % sys.version.split()[0]]
for m in ("numpy", "scipy", "torch", "sbi", "zuko", "skopt", "pytorch_metric_learning"):
    try:
        out.append("%s %s" % (m, getattr(importlib.import_module(m), "__version__", "?")))
    except Exception as e:                      # reported, and the suites will say the rest
        out.append("%s MISSING (%s)" % (m, type(e).__name__))
print("W1CHECK: environment: " + ", ".join(out))
EOF

mkdir -p "$OUT"
set +e
FAILED=""
N=0
for s in $SUITES; do
    N=$((N + 1))
    log="$OUT/${s%.py}.log"
    t0=$(date +%s)
    python3 "$TESTS/$s" > "$log" 2>&1
    rc=$?
    last="$(grep -v '^[[:space:]]*$' "$log" | tail -n 1 | cut -c1-120)"
    echo "W1CHECK: $s: rc $rc: $last  [$(( $(date +%s) - t0 )) s; $log]"
    if [ "$rc" != "0" ]; then FAILED="$FAILED $s"; fi
done

if [ -z "$FAILED" ]; then
    echo "W1CHECK: ALL $N SUITES PASSED at $HEAD_NOW (job ${REAL_JOB:-<none>})"
    exit 0
fi
echo "W1CHECK: FAILED:$FAILED (at $HEAD_NOW; the whole output of each is under $OUT)"
exit 1
